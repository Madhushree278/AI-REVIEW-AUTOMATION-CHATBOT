# ==============================================================
# AI-Powered Intern Review Automation - Environment Configuration
# ==============================================================

# Application & Security
APP_NAME="AI-Powered Intern Review Automation System"
APP_ENV="development"
SECRET_KEY="super-secret-jwt-key-change-this-in-production-random-64-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./intern_review.db"
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/intern_review

# AI / LLM Configuration
# Providers: 'auto', 'gemini', 'groq', 'openai', or 'heuristic'
LLM_PROVIDER="auto"
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="gemini-2.0-flash"

# Email Configuration
# Providers: 'mock' (logs to DB and console without sending), 'smtp', or 'gmail'
EMAIL_PROVIDER="mock"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="intern-reviews@company.com"
SMTP_USE_TLS=true

# Google Calendar & Meet Integration (OAuth 2.0)
# Leave empty to use manual Google Meet link entry
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
DEFAULT_TIMEZONE="Asia/Kolkata"

# File Upload Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS="pdf,docx,txt,py,js,ts,html,css,java,cpp,c,zip,json,md"
